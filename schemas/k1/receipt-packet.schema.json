{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "schema": {
          "enum": [
            "cmba.workbench-bundle.v0.1-i1",
            "cmba.workbench-bundle.j1"
          ]
        },
        "values": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "binding",
        "values",
        "context"
      ],
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "context_source": {
      "enum": [
        "READER_SELECTED",
        "DOCUMENT_DEMO_UNTRUSTED"
      ]
    },
    "document_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt": {
      "type": "object"
    },
    "schema": {
      "const": "cmba.receipt-packet.k1"
    }
  },
  "required": [
    "schema",
    "document_id",
    "bundle",
    "context",
    "context_source",
    "receipt"
  ],
  "type": "object"
}
