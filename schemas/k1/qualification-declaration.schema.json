{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_results": {
      "type": "object"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "realization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "semantic_commitment": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "semantic_commitment",
    "realization_sha256",
    "corpus_sha256",
    "claimed_results"
  ],
  "type": "object"
}
