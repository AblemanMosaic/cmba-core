{
  "$defs": {
    "record-coordination": {
      "additionalProperties": false,
      "properties": {
        "jurisdiction": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "participants": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "rounds": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "phase": {
                "maximum": 1,
                "minimum": 0,
                "type": "integer"
              },
              "previous_round_hash": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "statements": {
                "items": {
                  "$ref": "#/$defs/signed-statement"
                },
                "maxItems": 64,
                "minItems": 0,
                "type": "array"
              }
            },
            "required": [
              "phase",
              "previous_round_hash",
              "statements"
            ],
            "type": "object"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/reference"
        },
        "terms": {}
      },
      "required": [
        "subject",
        "terms",
        "participants",
        "jurisdiction",
        "rounds"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "SHA-256",
            "BLAKE3-256"
          ]
        },
        "digest_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scheme": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "algorithm",
        "digest_hex"
      ],
      "type": "object"
    },
    "signed-statement": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/statement-body"
        },
        "record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.signed-statement.j1"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "body",
        "signature_hex",
        "record_hash"
      ],
      "type": "object"
    },
    "statement-body": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "kind": {
          "enum": [
            "endorsement",
            "approval",
            "consent-grant",
            "consent-withdrawal",
            "coordination",
            "observation",
            "execution-observation"
          ]
        },
        "payload": {
          "type": "object"
        },
        "public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.statement-body.j1"
        }
      },
      "required": [
        "schema",
        "kind",
        "payload",
        "algorithm",
        "public_key"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cmba:j1:record-coordination",
  "$ref": "#/$defs/record-coordination",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
