{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "binding_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/binding-body"
        },
        "schema": {
          "const": "cmba.binding.v0.1-i1"
        }
      },
      "required": [
        "schema",
        "body",
        "binding_root"
      ],
      "type": "object"
    },
    "binding-body": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/profile-reference"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "schema": {
          "const": "cmba.binding-body.v0.1-i1"
        }
      },
      "required": [
        "schema",
        "profile",
        "dimensions",
        "relations"
      ],
      "type": "object"
    },
    "dimension": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "codec": {
          "const": "cmba-cjson-i1"
        },
        "critical": {
          "type": "boolean"
        },
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "value_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "role",
        "schema_id",
        "codec",
        "algorithm",
        "critical",
        "value_hash"
      ],
      "type": "object"
    },
    "profile-reference": {
      "additionalProperties": false,
      "properties": {
        "contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "profile_version": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "contract_hash"
      ],
      "type": "object"
    },
    "record-endorsements": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "values": {
          "type": "object"
        }
      },
      "required": [
        "binding",
        "values"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "SHA-256",
            "BLAKE3-256"
          ]
        },
        "digest_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scheme": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "algorithm",
        "digest_hex"
      ],
      "type": "object"
    },
    "relation": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "relation_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "relation_id",
        "predicate",
        "target"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cmba:j1:record-endorsements",
  "$ref": "#/$defs/record-endorsements",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
