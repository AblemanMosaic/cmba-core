{
  "$defs": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "members": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "jurisdictions": {
                "items": {
                  "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
                  "type": "string"
                },
                "maxItems": 64,
                "minItems": 0,
                "type": "array"
              },
              "public_key": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "roles": {
                "items": {
                  "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
                  "type": "string"
                },
                "maxItems": 64,
                "minItems": 0,
                "type": "array"
              }
            },
            "required": [
              "public_key",
              "roles",
              "jurisdictions"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        },
        "revoked_keys": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "members",
        "revoked_keys"
      ],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "binding_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/binding-body"
        },
        "schema": {
          "const": "cmba.binding.v0.1-i1"
        }
      },
      "required": [
        "schema",
        "body",
        "binding_root"
      ],
      "type": "object"
    },
    "binding-body": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/profile-reference"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "schema": {
          "const": "cmba.binding-body.v0.1-i1"
        }
      },
      "required": [
        "schema",
        "profile",
        "dimensions",
        "relations"
      ],
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "authority_snapshot": {
          "$ref": "#/$defs/authority"
        },
        "evidence_snapshot": {
          "items": {
            "$ref": "#/$defs/signed-statement"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        },
        "expected_binding_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "parameters": {
              "type": "object"
            },
            "profile": {
              "$ref": "#/$defs/profile-reference"
            },
            "required_checks": {
              "items": {
                "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            }
          },
          "required": [
            "profile",
            "required_checks",
            "parameters"
          ],
          "type": "object"
        },
        "schema": {
          "const": "cmba.evaluation-context.j1"
        },
        "time": {
          "additionalProperties": false,
          "properties": {
            "clock_source": {
              "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
              "type": "string"
            },
            "epoch": {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "epoch",
            "clock_source"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema",
        "expected_binding_root",
        "policy",
        "authority_snapshot",
        "evidence_snapshot",
        "time"
      ],
      "type": "object"
    },
    "dimension": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "codec": {
          "const": "cmba-cjson-i1"
        },
        "critical": {
          "type": "boolean"
        },
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "value_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "role",
        "schema_id",
        "codec",
        "algorithm",
        "critical",
        "value_hash"
      ],
      "type": "object"
    },
    "disclosure-header": {
      "additionalProperties": false,
      "properties": {
        "disclosure_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "leaf_count": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "merkle_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.disclosure-header.j1"
        }
      },
      "required": [
        "schema",
        "leaf_count",
        "merkle_root",
        "disclosure_root"
      ],
      "type": "object"
    },
    "disclosure-leaf": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "maximum": 63,
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "salt_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.disclosure-leaf.j1"
        },
        "schema_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "schema",
        "index",
        "label",
        "schema_id",
        "value",
        "salt_hex"
      ],
      "type": "object"
    },
    "disclosure-opening": {
      "additionalProperties": false,
      "properties": {
        "leaf": {
          "$ref": "#/$defs/disclosure-leaf"
        },
        "path": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "hash": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "side": {
                "enum": [
                  "left",
                  "right"
                ]
              }
            },
            "required": [
              "side",
              "hash"
            ],
            "type": "object"
          },
          "maxItems": 6,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "leaf",
        "path"
      ],
      "type": "object"
    },
    "endorsed-envelope": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "additionalProperties": false,
          "properties": {
            "binding": {
              "$ref": "#/$defs/binding"
            },
            "endorsements": {
              "items": {
                "$ref": "#/$defs/signed-statement"
              },
              "maxItems": 64,
              "minItems": 0,
              "type": "array"
            },
            "schema": {
              "const": "cmba.endorsed-envelope-body.j1"
            },
            "values": {
              "type": "object"
            }
          },
          "required": [
            "schema",
            "binding",
            "values",
            "endorsements"
          ],
          "type": "object"
        },
        "envelope_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.endorsed-envelope.j1"
        }
      },
      "required": [
        "schema",
        "body",
        "envelope_hash"
      ],
      "type": "object"
    },
    "profile-reference": {
      "additionalProperties": false,
      "properties": {
        "contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "profile_version": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "contract_hash"
      ],
      "type": "object"
    },
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/receipt-body"
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.application-receipt.j1"
        }
      },
      "required": [
        "schema",
        "body",
        "receipt_hash"
      ],
      "type": "object"
    },
    "receipt-body": {
      "additionalProperties": false,
      "properties": {
        "authority_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "binding_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evaluator": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "cmba.applications.j1"
            },
            "realization_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "realization_sha256"
          ],
          "type": "object"
        },
        "evidence_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/profile-reference"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "schema": {
          "const": "cmba.application-receipt-body.j1"
        },
        "signature": {
          "const": "NOT_SIGNED"
        },
        "supplied_values_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "time_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "binding_root",
        "profile",
        "supplied_values_hash",
        "context_hash",
        "policy_hash",
        "authority_snapshot_hash",
        "evidence_snapshot_hash",
        "time_hash",
        "evaluator",
        "result",
        "signature"
      ],
      "type": "object"
    },
    "record-disclosure": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/disclosure-header"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/disclosure-opening"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "header",
        "openings"
      ],
      "type": "object"
    },
    "record-native": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "type": "object"
        },
        "operation": {
          "enum": [
            "archive",
            "namespace",
            "lineage",
            "lifecycle",
            "assurance",
            "distributed"
          ]
        }
      },
      "required": [
        "operation",
        "arguments"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "SHA-256",
            "BLAKE3-256"
          ]
        },
        "digest_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scheme": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "algorithm",
        "digest_hex"
      ],
      "type": "object"
    },
    "relation": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "relation_id": {
          "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "relation_id",
        "predicate",
        "target"
      ],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "evaluate"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "$ref": "#/$defs/binding"
                  },
                  "context": {
                    "$ref": "#/$defs/context"
                  },
                  "values": {
                    "type": "object"
                  }
                },
                "required": [
                  "binding",
                  "values",
                  "context"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "replay"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "$ref": "#/$defs/binding"
                  },
                  "context": {
                    "$ref": "#/$defs/context"
                  },
                  "receipt": {
                    "$ref": "#/$defs/receipt"
                  },
                  "values": {
                    "type": "object"
                  }
                },
                "required": [
                  "receipt",
                  "binding",
                  "values",
                  "context"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "profiles"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {},
                "required": [],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "capabilities"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {},
                "required": [],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "verify-statement"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "record": {
                    "$ref": "#/$defs/signed-statement"
                  }
                },
                "required": [
                  "record"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "verify-envelope"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "envelope": {
                    "$ref": "#/$defs/endorsed-envelope"
                  }
                },
                "required": [
                  "envelope"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "verify-disclosure"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "expected_root": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "view": {
                    "$ref": "#/$defs/record-disclosure"
                  }
                },
                "required": [
                  "view",
                  "expected_root"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "dkn-read"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "$ref": "#/$defs/record-native"
                  }
                },
                "required": [
                  "request"
                ],
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "arguments": {
          "type": "object"
        },
        "operation": {
          "enum": [
            "evaluate",
            "replay",
            "profiles",
            "capabilities",
            "verify-statement",
            "verify-envelope",
            "verify-disclosure",
            "dkn-read"
          ]
        },
        "schema": {
          "const": "cmba.request.j1"
        }
      },
      "required": [
        "schema",
        "operation",
        "arguments"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "authority_effect": {
          "const": "NONE"
        },
        "authorization": {
          "const": "EXTERNAL_DECISION_REQUIRED"
        },
        "checks": {
          "additionalProperties": {
            "enum": [
              "MATCH",
              "CONTRADICTED",
              "UNSUPPORTED",
              "INSUFFICIENT",
              "NO_MATCH",
              "NATIVE_REPORT_COMPUTED"
            ]
          },
          "minProperties": 1,
          "type": "object"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "freshness": {
          "const": "SUPPLIED_VIEW_ONLY"
        },
        "schema": {
          "const": "cmba.application-result.j1"
        },
        "semantic_truth": {
          "const": "NOT_ESTABLISHED"
        },
        "status": {
          "enum": [
            "MATCH_FOR_SUPPLIED_EVIDENCE",
            "CONTRADICTED",
            "UNSUPPORTED",
            "INSUFFICIENT",
            "NO_MATCH",
            "NATIVE_REPORT_COMPUTED"
          ]
        },
        "uninterpreted_dimensions": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:/-]{0,191}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "schema",
        "status",
        "checks",
        "details",
        "claim_ceiling",
        "authority_effect",
        "authorization",
        "freshness",
        "semantic_truth"
      ],
      "type": "object"
    },
    "signed-statement": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/statement-body"
        },
        "record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.signed-statement.j1"
        },
        "signature_hex": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "body",
        "signature_hex",
        "record_hash"
      ],
      "type": "object"
    },
    "statement-body": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "kind": {
          "enum": [
            "endorsement",
            "approval",
            "consent-grant",
            "consent-withdrawal",
            "coordination",
            "observation",
            "execution-observation"
          ]
        },
        "payload": {
          "type": "object"
        },
        "public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "cmba.statement-body.j1"
        }
      },
      "required": [
        "schema",
        "kind",
        "payload",
        "algorithm",
        "public_key"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cmba:j1:request",
  "$ref": "#/$defs/request",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
